{
  "name": "@neode/beta",
  "version": "0.2.0",
  "description": "Decorator-based Object Graph Mapper for Neo4j and Cypher-compatible graph databases",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "sideEffects": [
    "dist/decorators/relationship/other-node.decorator.js"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run test:unit",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "vitest bench --project unit",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "neo4j",
    "ogm",
    "graph",
    "cypher",
    "orm",
    "memgraph",
    "decorators"
  ],
  "author": "Adam Cowley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adam-cowley/neode-ogm.git"
  },
  "bugs": {
    "url": "https://github.com/adam-cowley/neode-ogm/issues"
  },
  "homepage": "https://github.com/adam-cowley/neode-ogm#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "neo4j-driver": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@swc/core": "^1.10.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
